# Configuracao local do frontend. Copie para `.env.local` (fora do Git).
#
# Nenhum segredo entra aqui: tudo que o Vite expoe com o prefixo VITE_ vai
# para o pacote enviado ao navegador e e publico por definicao.

# Vazio = mesma origem, usando o proxy do `vite dev` (ver vite.config.ts).
# Preencha somente quando a API estiver em outro host.
VITE_API_BASE_URL=

# Para onde o proxy de desenvolvimento aponta.
VITE_API_PROXY_TARGET=http://localhost:5175
