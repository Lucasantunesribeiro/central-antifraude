# ---------------------------------------------------------------------------
# Central Antifraude - exemplo de configuracao local
#
# Copie este arquivo para `.env` e ajuste os valores.
# `.env` esta no .gitignore e NUNCA deve ser commitado.
# Nenhum valor real de producao pode ser escrito aqui.
# ---------------------------------------------------------------------------

# Credenciais do PostgreSQL local subido pelo docker-compose.
# Sao credenciais descartaveis de desenvolvimento, validas apenas no container.
POSTGRES_DB=central_antifraude
POSTGRES_USER=central_antifraude
POSTGRES_PASSWORD=troque-este-valor-localmente
# 5434 e nao 5432: nesta maquina a 5432 tem um PostgreSQL nativo e a 5433 tem
# o container de outro projeto. Ajuste conforme a sua.
# Ajuste se a sua nao tiver.
POSTGRES_PORT=5434

# String de conexao lida pela API (ConnectionStrings:Postgres).
# O separador `__` e a convencao do .NET para secoes de configuracao.
ConnectionStrings__Postgres=Host=localhost;Port=5434;Database=central_antifraude;Username=central_antifraude;Password=troque-este-valor-localmente
